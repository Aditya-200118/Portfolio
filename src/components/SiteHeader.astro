---
import { navigation, siteMeta } from '../data/site';
import { buildPath } from '../lib/urls';

const currentPath = Astro.url.pathname;
const homePath = buildPath();

function isActive(path: string) {
  const resolved = buildPath(path);
  if (resolved === homePath) {
    return currentPath === homePath;
  }
  return currentPath.startsWith(resolved);
}
---

<header class="site-header">
  <a class="brand" href={homePath}>
    <span class="brand-name">{siteMeta.title}</span>
    <span class="brand-note">{siteMeta.roleLine}</span>
  </a>

  <div class="header-controls">
    <nav class="site-nav" aria-label="Primary">
      {navigation.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={buildPath(item.href)}
            aria-current={active ? 'page' : undefined}
            class:list={{ active }}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle dark mode">
      <span class="theme-toggle__swatch" aria-hidden="true"></span>
      <span class="theme-toggle__label" data-theme-label>Dark mode</span>
    </button>
  </div>
</header>
