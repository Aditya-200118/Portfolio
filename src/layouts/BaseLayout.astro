---
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { buildPath } from '../lib/urls';
import { siteMeta } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = siteMeta.description } = Astro.props;
const pageTitle = title ? `${title} | ${siteMeta.title}` : siteMeta.title;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f6f7" />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    {canonical && <link rel="canonical" href={canonical.href} />}
    <link rel="icon" type="image/svg+xml" href={buildPath('favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (() => {
        const key = 'portfolio-theme';
        const root = document.documentElement;
        const metaTheme = document.querySelector('meta[name="theme-color"]');
        const themeColor = {
          light: '#f4f3f8',
          dark: '#090b12',
        };

        const getPreferredTheme = () => {
          const stored = localStorage.getItem(key);
          if (stored === 'light' || stored === 'dark') {
            return stored;
          }

          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        };

        const applyTheme = (theme) => {
          root.dataset.theme = theme;
          root.style.colorScheme = theme;
          metaTheme?.setAttribute('content', themeColor[theme] || themeColor.light);
        };

        const initialTheme = getPreferredTheme();
        applyTheme(initialTheme);

        window.__portfolioTheme = {
          get: () => root.dataset.theme || getPreferredTheme(),
          set: (theme) => {
            applyTheme(theme);
            localStorage.setItem(key, theme);
            window.dispatchEvent(new CustomEvent('portfolio-theme-change', { detail: { theme } }));
          },
        };
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="site-shell">
      <SiteHeader />
      <main id="content" class="site-main">
        <slot />
      </main>
      <SiteFooter />
    </div>
    <script is:inline>
      (() => {
        const syncThemeControls = () => {
          const currentTheme = window.__portfolioTheme?.get?.() || 'light';
          const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';

          document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
            button.setAttribute('aria-label', `Switch to ${nextTheme} mode`);
          });

          document.querySelectorAll('[data-theme-label]').forEach((label) => {
            label.textContent = nextTheme === 'dark' ? 'Dark mode' : 'Light mode';
          });
        };

        const bindThemeControls = () => {
          document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
            if (button.dataset.boundThemeToggle === 'true') {
              return;
            }

            button.dataset.boundThemeToggle = 'true';
            button.addEventListener('click', () => {
              const currentTheme = window.__portfolioTheme?.get?.() || 'light';
              const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';
              window.__portfolioTheme?.set?.(nextTheme);
              syncThemeControls();
            });
          });
        };

        bindThemeControls();
        syncThemeControls();
        window.addEventListener('portfolio-theme-change', syncThemeControls);
      })();
    </script>
  </body>
</html>
